{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LLM Gateway — Run & Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.api.main:app",
        "--reload",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "LLM Gateway — Seed Demo Data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/demo/seed_demo_data.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
