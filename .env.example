# LLM Gateway POC — Environment Variables
# Copy this file to .env and adjust values as needed
# No real API keys required — all providers are simulated

# ── App ──────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# ── Security ─────────────────────────────────────────
# Pre-defined API keys for each tier (comma-separated key:tier pairs)
# Format: key1:tier1,key2:tier2
API_KEYS=free-key-001:free,basic-key-001:basic,pro-key-001:pro,enterprise-key-001:enterprise

# ── Semantic Cache ────────────────────────────────────
CACHE_SIMILARITY_THRESHOLD=0.75
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000
CACHE_FILE=data/cache.json

# ── Analytics ────────────────────────────────────────
ANALYTICS_FILE=data/analytics.json

# ── Provider Health ───────────────────────────────────
PROVIDER_HEALTH_FILE=data/provider_health.json

# ── Circuit Breaker ───────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_SECONDS=60
CB_PROBE_COUNT=3

# ── Provider Failure Rates (0.0 = never fails, 1.0 = always fails) ──
OPENAI_FAILURE_RATE=0.05
ANTHROPIC_FAILURE_RATE=0.03
GOOGLE_FAILURE_RATE=0.04

# ── Provider Latency Multiplier (1.0 = normal, 2.0 = double slowness) ──
OPENAI_LATENCY_MULTIPLIER=1.0
ANTHROPIC_LATENCY_MULTIPLIER=1.0
GOOGLE_LATENCY_MULTIPLIER=1.0
